# LlamaIndex AI Configuration
LLAMAINDEX_API_KEY=your_llamaindex_api_key_here
LLAMAINDEX_PROJECT_ID=a5de2515-4769-4b0d-b319-7cc4addb5f01

# Agent Services Configuration
PLUTOPRINT_API_URL=http://localhost:8001
PARLANT_API_URL=http://localhost:8002
MOTIA_API_URL=http://localhost:8003
BASEDASH_API_URL=http://localhost:8004

# Universal RAG Configuration
RAG_VECTOR_DB_URL=http://localhost:5432
RAG_EMBEDDING_MODEL=text-embedding-ada-002
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# Fitness Signals Kit
BANGLE_DEVICE_API=enabled
FITNESS_COACH_MODEL=gpt-4-turbo

# Agent-to-Agent Protocol
AGENT_PROTOCOL_VERSION=v2.0
AGENT_FALLBACK_ENABLED=true
AGENT_CLOUD_SYNC=true

# Monetization Modules
STRIPE_PUBLISHABLE_KEY=your_stripe_key_here
STRIPE_SECRET_KEY=your_stripe_secret_here
PRICING_TIER=basic

# SSO Configuration (for Ops Portal)
OIDC_CLIENT_ID=your_oidc_client_id
OIDC_CLIENT_SECRET=your_oidc_client_secret
OIDC_ISSUER=your_oidc_issuer
OIDC_REDIRECT_URI=your_oidc_redirect_uri

# Budibase Configuration
BUDIBASE_UPSTREAM=http://localhost:10000

# Development
NODE_ENV=development
VITE_APP_NAME=ARCHON X
VITE_APP_VERSION=2.0.0